# ============================================================
# CineForge server · 环境变量模板
# 本地开发可复制为 .env（docker compose 自动读取）或 export；
# 生产在云效流水线/ECS 注入。所有值均为占位/默认，请按实际填写。
# ============================================================

# ---- 服务监听 ----
CINEFORGE_HTTP_ADDR=0.0.0.0:8080
CINEFORGE_GRPC_ADDR=0.0.0.0:8090

# ---- 数据库（单库 cineforge）----
# 与 docker-compose.yml 的 POSTGRES_PASSWORD（.env 里 CINEFORGE_DB_PASSWORD）保持一致
CINEFORGE_DB_DSN=postgres://cineforge:CHANGE_ME@127.0.0.1:5432/cineforge

# ---- 登录令牌（auth）----
# 生产必须换成不可预测的随机值，并保持 3 个 secret 生命周期一致（session≤8h）
CINEFORGE_AUTH_SECRET=CHANGE_ME_long_random_auth_secret
CINEFORGE_AUTH_SESSION_TTL_SECONDS=28800
CINEFORGE_TAPCANVAS_JWT_SECRET=CHANGE_ME_long_random_tapcanvas_secret
# RS256 platform_token 私钥（单行，换行用 \n 转义）+ kid
CINEFORGE_PLATFORM_JWT_PRIVATE_KEY=CHANGE_ME_pem_private_key
CINEFORGE_PLATFORM_JWT_KID=cineforge-platform
# 文件播放/下载 token 有效期（秒，实际 clamp 到 [1,300]，默认 300）
CINEFORGE_FILE_PLAYBACK_TOKEN_TTL_SECONDS=300

# ---- MinIO（本地开发用 docker compose up minio，默认账号见下方私有段）----
CINEFORGE_MINIO_ENDPOINT=127.0.0.1:9000
CINEFORGE_MINIO_BUCKET=cineforge-assets
CINEFORGE_MINIO_ACCESS_KEY=cineforge
CINEFORGE_MINIO_SECRET_KEY=dev_local_minio_pw
CINEFORGE_MINIO_USE_SSL=false

# ---- 域名 ----
CINEFORGE_SERVER_DOMAIN=cine-forge-server.cnjm.top
CINEFORGE_WEB_DOMAIN=cine-forge.cnjm.top

# ---- 依赖服务 ----
# Hermes（模型网关）：base_url 含 /v1 段；default API key 占位视为未配置（api_key_configured=false）。
CINEFORGE_HERMES_ENABLED=true
CINEFORGE_HERMES_ADDR=http://127.0.0.1:8642/v1
CINEFORGE_HERMES_HEALTH_URL=http://127.0.0.1:8642/health
CINEFORGE_HERMES_MODEL=hermes-agent
# CINEFORGE_HERMES_DASHBOARD_URL=http://127.0.0.1:9119
# CINEFORGE_HERMES_WEBUI_URL=http://127.0.0.1:3000
# CINEFORGE_HERMES_API_KEY=change-me-hermes-local
CINEFORGE_AGENT_ADDR=http://127.0.0.1:8091

# Redis：Celery broker + run-events 项目事件 channel（P4d；agent 子模块共用同一 Redis）。
# 未配置时 run-events 按契约返回 503 + Retry-After，前端降级 5s 轮询。
CINEFORGE_REDIS_URL=redis://127.0.0.1:6379/0

# ---- 开发账号自动种子（仅本地 dev；生产保持 CINEFORGE_DEVSEED_ENABLED=false）----
# 开启后启动时按 phone 幂等创建开发账号，新拉代码不再需要手工造号即可登录联调。
# username/display_name/role 有默认值（dev / 开发账号 / admin），可不填。
CINEFORGE_DEVSEED_ENABLED=true
CINEFORGE_DEVSEED_PHONE=13800000000
CINEFORGE_DEVSEED_PASSWORD=CineForge@123
CINEFORGE_DEVSEED_USERNAME=dev
CINEFORGE_DEVSEED_DISPLAY_NAME=开发账号
CINEFORGE_DEVSEED_ROLE=admin

# ---- docker compose（私有）----
# CINEFORGE_DB_PASSWORD=CHANGE_ME
# MINIO_ROOT_USER=cineforge
# MINIO_ROOT_PASSWORD=CHANGE_ME